    "scripts": {
        "installation": {
            "script": "#!/bin/bash\nset -euo pipefail\nmkdir -p /mnt/server\necho 'PHP Web: existing files are preserved. Upload your website using SFTP.'\n",
            "container": "debian:bookworm-slim",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Web Root",
            "description": "Use public for Laravel; . for regular PHP or WordPress",
            "env_variable": "WEB_ROOT",
            "default_value": ".",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|string|in:.,public",
            "field_type": "text"
